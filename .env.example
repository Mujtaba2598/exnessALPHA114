NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
DATABASE_FILE=./data/alpha.sqlite

# Owner bootstrap credentials. Never commit a real .env file.
OWNER_EMAIL=owner@example.com
OWNER_PASSWORD=replace-with-a-strong-password-at-least-12-chars

# Server-side secrets.
JWT_SECRET=replace-with-a-long-random-secret
ENCRYPTION_KEY=replace-with-32-byte-hex-key

# TickerAll server-side API key.
TICKERALL_API_KEY=cf_api_replace_me
TICKERALL_BASE_URL=https://api.tickerall.com

# Safety defaults.
LIVE_ORDER_EXECUTION=false
MAX_CONCURRENT_POSITIONS=10
RISK_PERCENT=0.5
DAILY_LOSS_CAP=2.0
MAX_POSITION_PERCENT=10
CASH_RESERVE_PERCENT=20
MIN_REWARD_RISK=1.5
MIN_CONFIDENCE=0.68
BOT_TICK_MS=15000
